# ── Neon ──────────────────────────────────────────────
# Console → your project → Connection Details.
# Role: neondb_owner. Database: neondb. SSL: require (already in the URI).

# Pooled (host looks like ep-xxxx-pooler.region.aws.neon.tech)
# Used by the Flask app at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Direct / non-pooled (host looks like ep-xxxx.region.aws.neon.tech, no "-pooler")
# Used only to apply db/schema.sql. Do not point the app at this.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ── App secrets (not from Neon) ───────────────────────
# 32-byte key as 64 hex chars. Encrypts each user's OpenRouter API key at rest.
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# OpenRouter keys are entered in the UI per user. They do not belong here.
